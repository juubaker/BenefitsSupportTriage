yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE — keep .vscode/ committed for shared settings, but ignore user-specific files
.vscode/*.log
.idea/
