# Copy this file to .env and fill in your values.
# Get an Anthropic key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides. Defaults are tuned for cost/latency:
#   - Haiku for fast triage classification
#   - Sonnet for the higher-quality drafted response
ANTHROPIC_MODEL_TRIAGE=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_DRAFT=claude-sonnet-4-6

# Server port (Vite proxies /api here)
PORT=3001

# Postgres connection. The default targets the local docker-compose service.
# For Neon/Supabase/RDS, paste the connection string they provide.
DATABASE_URL=postgresql://triage:triage@localhost:5432/triage
