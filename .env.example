# Copy this file to .env and fill in your values.
# Get an Anthropic key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides. Defaults are tuned for cost/latency:
#   - Haiku for fast triage classification
#   - Sonnet for the higher-quality drafted response
ANTHROPIC_MODEL_TRIAGE=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_DRAFT=claude-sonnet-4-6

# Server port (Vite proxies /api here)
PORT=3001

# Postgres connection. The default targets the local docker-compose service.
# For Neon/Supabase/RDS, paste the connection string they provide.
# docker-compose publishes Postgres on host port 5433 (see docker-compose.yml).
DATABASE_URL=postgresql://triage:triage@localhost:5433/triage

# Ollama: embeddings for retrieval (must match the ingest model) and the
# local chat model for the agent.
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_MODEL=qwen2.5

# Where the MCP server's get_eval_metrics tool reads the eval scorecard.
# This is where `python -m run --suite smoke` writes it from inside evals/.
EVAL_REPORT_PATH=./evals/eval/scorecards/latest.json

# Similarity floors. The two corpora are measured separately: the policy sweep
# (evals/retrieval_eval.py) gives 0.65, and evals/ticket_floor.py gives 0.60 for
# resolved tickets, where a lower floor is needed and anything above 0.5779
# would admit precedent to tickets that must escalate.
# RETRIEVAL_MIN_SIM=0.65
# RETRIEVAL_TICKET_MIN_SIM=0.6

# OpenTelemetry export for agent traces (observability/ stack).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# v2 agent mounted at POST /api/triage. Set to "false" to skip mounting it.
AGENT_ENABLED=true
AGENT_DEFAULT_PROVIDER=ollama
AGENT_TRACING=false

# Override or extend the model pricing table used for the token ledger and the
# run's cost column, e.g. '{"claude-sonnet-4-6":{"inputPerMTok":3,"outputPerMTok":15}}'
# AGENT_PRICING_JSON=

# --- Eval suite (evals/) --------------------------------------------------
# Where the suite reaches the app. The dev server listens on 3001; the default
# in wiring.example.py used to say 3000, which fails on case one.
AGENT_APP_URL=http://localhost:3001

# Trajectory judge. The judge family MUST differ from the worker's —
# JudgeConfig.validate() refuses otherwise, because a model grading its own
# family inflates the score it exists to check. Worker on Claude, judge on a
# local llama: free, and genuinely independent.
AGENT_WORKER_FAMILY=claude
EVAL_JUDGE_MODEL=llama3.1
EVAL_JUDGE_FAMILY=llama
