# Copy this file to .env and fill in your values.
# Get an Anthropic key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides. Defaults are tuned for cost/latency:
#   - Haiku for fast triage classification
#   - Sonnet for the higher-quality drafted response
ANTHROPIC_MODEL_TRIAGE=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_DRAFT=claude-sonnet-4-6

# Server port (Vite proxies /api here)
PORT=3001

# Postgres connection. The default targets the local docker-compose service.
# For Neon/Supabase/RDS, paste the connection string they provide.
# docker-compose publishes Postgres on host port 5433 (see docker-compose.yml).
DATABASE_URL=postgresql://triage:triage@localhost:5433/triage

# Ollama: embeddings for retrieval (must match the ingest model) and the
# local chat model for the agent.
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_MODEL=qwen2.5

# Where the MCP server's get_eval_metrics tool reads its answer-quality report.
EVAL_REPORT_PATH=./eval/results/latest.json

# OpenTelemetry export for agent traces (observability/ stack).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
